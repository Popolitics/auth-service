DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=votre_mot_de_passe_robuste
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# Réinitialisation du mot de passe : page frontend qui reçoit ?uid=…&token=…
PASSWORD_RESET_URL=http://localhost:3000/reset-password
DEFAULT_FROM_EMAIL=no-reply@localhost

# Envoi des emails (SMTP). Sans EMAIL_HOST, ils sont seulement affichés dans la console.
# Dev : Mailpit (`docker compose up -d mailpit`), mails visibles sur http://localhost:8025.
# docker compose force déjà ces valeurs pour le conteneur auth-service.
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
# Prod (ex. Brevo) : EMAIL_HOST=smtp-relay.brevo.com, EMAIL_PORT=587, EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=


# Paire RSA pour signer les JWT (RS256). Seul auth-service détient la clé
# PRIVÉE. Générer une paire par environnement, ex. :
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# En local, pointer directement sur les fichiers (chemins relatifs à la racine
# du projet ; *.pem est ignoré par Git et par l'image Docker).
# NE JAMAIS commiter les vraies clés — ce fichier n'est qu'un exemple.
JWT_PRIVATE_KEY_FILE=private.pem
# La clé publique doit être IDENTIQUE à celle distribuée aux autres services
# (data-service, etc.) — c'est la seule chose à partager avec eux.
JWT_PUBLIC_KEY_FILE=public.pem
# Alternative (CI, Kubernetes…) : passer le contenu des clés, avec des \n
# littéraux à la place des retours à la ligne. *_FILE est prioritaire.
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
